#!/bin/sh
# Google Drive File Stream writes a desktop.ini into every folder it syncs, to
# set the folder icon. This repo lives inside a Drive-synced path, so Drive
# walks into .git/refs/ and drops one there too — and git treats ANY file under
# refs/ as a ref, so refs/desktop.ini becomes "fatal: bad object refs/desktop.ini"
# and breaks fetch/push/log.
#
# .gitignore cannot prevent this: it governs the working tree only, never .git/
# internals. So the fix has to run at git time, which is what this hook does.
#
# Cheap (a find over .git, no network) and safe: desktop.ini is never a
# legitimate git file, so deleting it inside .git/ can lose nothing.
find "$(git rev-parse --git-dir)" -name 'desktop.ini' -delete 2>/dev/null
exit 0
