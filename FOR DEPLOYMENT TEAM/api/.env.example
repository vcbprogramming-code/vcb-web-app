# The Express API. Copy to .env and fill in — .env is gitignored and must
# never be committed; this file is the template that documents what is needed.
#
# The API is the ONLY holder of database credentials. The browser talks to this
# and nothing else, so none of these values ever reach a client bundle.

# ---------------------------------------------------------------- database --
# Supabase → Project Settings → Database → Connection string → URI.
# Use the CONNECTION POOLER string (port 6543), not the direct one (5432):
# Render dials out over IPv4 and Supabase's direct host is IPv6-only, so the
# direct string fails to connect from there with no useful error.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------- auth --
# Signs every JWT. At least 32 characters; the API refuses to boot below that,
# because a short secret means every token it issues is forgeable and the
# failure is silent at runtime. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a session lasts. Roles and HR site scope are baked into the token at
# sign-in, so a role change does not take effect until the token expires.
JWT_TTL=12h

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Only the client ID belongs here — it is public by design
# and the browser sends it. The client SECRET is not used by this API.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------- CORS --
# Comma-separated, exact origins, no trailing slash. Every SPA that calls this
# API needs its Vercel URL listed, plus localhost for development. An origin
# not on this list is refused — the API never reflects an arbitrary Origin.
CORS_ORIGINS=http://localhost:5173,https://vcb-portal.vercel.app

# ---------------------------------------------------------------- storage --
# Supabase → Project Settings → Storage → S3 Connection. Reached through the
# AWS S3 SDK rather than the Supabase client, so the whole stack has one
# storage client and the Supabase library never appears server-side.
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ email --
# Brevo → SMTP & API → API Keys. HTTP API, not SMTP: Render blocks outbound
# SMTP ports on its lower tiers, so an SMTP transport works locally and then
# fails silently in production.
BREVO_API_KEY=
BREVO_SENDER_NAME=VCB Connect
BREVO_SENDER_EMAIL=

# ------------------------------------------------------------------- host --
# Render sets PORT itself; this is only for running locally.
PORT=8080
