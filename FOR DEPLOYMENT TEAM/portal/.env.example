# The single Express API (api/ at the repo root). The browser talks only to
# this — never to Supabase directly; the API is the only holder of database
# credentials. See TECH_STACK.md.
VITE_API_URL=http://localhost:8080

# The OAuth Client ID for this deployment's Google Cloud project (a "Web
# application" client, from console.cloud.google.com > APIs & Services >
# Credentials). Required for the Google sign-in button — without it, the
# button is hidden and only the password path is offered. This is a PUBLIC
# identifier (safe to ship to the browser); the API's own GOOGLE_CLIENT_ID
# (api/.env) must be the SAME value, since it verifies the token was issued
# for this exact client.
VITE_GOOGLE_CLIENT_ID=
